# --- CedarDB ---
export CEDAR_USER=postgres
export CEDAR_DB=postgres
export CEDAR_PASSWORD=''
export CEDAR_PORT=5432
export CEDAR_MEMORY_SIZE=8G
export CEDAR_PARALLEL=4

# --- PostgreSQL ---
export PG_PORT=5433
export PG_PASSWORD=''
export PG_DSN='dbname=postgres user=postgres password= host=127.0.0.1 port=5433'

# --- client ---
export DB_DSN='dbname=postgres user=postgres password= host=127.0.0.1 port=5432'
export DOOM_CLIENT_PARALLEL=8
export MAP_ID=1
